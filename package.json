{
  "name": "bobinarium",
  "version": "1.0.0",
  "description": "",
  "keywords": [],
  "author": "",
  "scripts": {
    "dev": "pnpm -r --parallel --stream --if-present run dev",
    "build": "pnpm -r --parallel --stream --if-present run build",
    "test": "pnpm -r --parallel --stream --if-present run test",
    "typecheck": "pnpm -r --parallel --stream --if-present run typecheck",
    "lint": "pnpm -r --parallel --stream --if-present run lint",
    "format": "pnpm -r --parallel --stream --if-present run format",
    "check": "pnpm -r --parallel --stream --if-present run check",
    "rm-modules": "find . -name 'node_modules' -type d -exec rm -rf '{}' +"
  },
  "devDependencies": {
    "typescript": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.22.0",
      "onFail": "download"
    }
  }
}
