{
  "name": "bobinarium",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "keywords": [],
  "author": "",
  "scripts": {
    "prepare": "effect-tsgo patch --oxlint",
    "dev": "pnpm -r --parallel --stream --if-present run dev",
    "build": "pnpm -r --parallel --stream --if-present run build",
    "test": "pnpm -r --parallel --stream --if-present run test",
    "typecheck": "pnpm -r --parallel --stream --if-present run typecheck",
    "lint": "oxlint back front packages",
    "lint:fix": "oxlint back front packages --fix",
    "format": "pnpm -r --parallel --stream --if-present run format",
    "format:check": "pnpm -r --parallel --stream --if-present run format:check",
    "check": "pnpm typecheck && pnpm test && pnpm lint && pnpm format:check",
    "rm-modules": "find . -name 'node_modules' -type d -exec rm -rf '{}' +"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.22.0",
      "onFail": "download"
    }
  }
}
