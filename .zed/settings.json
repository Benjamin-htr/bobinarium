{
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "**/repos/**"
  ],
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "preferences": {
            "autoImportFileExcludePatterns": ["repos/**"]
          }
        },
        "javascript": {
          "preferences": {
            "autoImportFileExcludePatterns": ["repos/**"]
          }
        }
      }
    }
  }
}
